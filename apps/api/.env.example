# Sao chép file này thành .env (không commit .env)
# Đường dẫn file SQLite, tính từ thư mục apps/api
DB_PATH=./data/ces-crm.sqlite
# Cổng API
API_PORT=8787

# Khóa bí mật để băm mã phiên đăng nhập: BẮT BUỘC, tối thiểu 32 ký tự ngẫu nhiên, mỗi máy một giá trị riêng.
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Các địa chỉ web được phép gửi yêu cầu ghi (cách nhau bằng dấu phẩy). Địa chỉ khác bị chặn.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Đặt true khi chạy qua https (cookie có thêm cờ Secure)
COOKIE_SECURE=false

# Mật khẩu chung cho các tài khoản MẪU do pnpm db:seed tạo (chỉ để học và thử). Tự đặt, không dùng mật khẩu thật của bạn.
SEED_PASSWORD=

# Khóa chung với dịch vụ AI (giống apps/ai/.env), tối thiểu 16 ký tự. Để trống thì không có nhãn "do AI làm".
AI_SERVICE_KEY=
