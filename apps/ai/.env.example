# Sao chép file này thành .env (không commit .env)
# Cổng dịch vụ AI và địa chỉ API CRM
AI_PORT=8788
API_URL=http://127.0.0.1:8787
# Nhà cung cấp AI qua chuẩn tương thích OpenAI (đang dùng DeepSeek)
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# Khóa API của BẠN (để trống thì chat trả 503). Không bao giờ commit, không gửi cho ai.
AI_API_KEY=
# Số lượt hỏi AI tối đa của mỗi người trong một giờ
ASKS_PER_HOUR=60
# Các địa chỉ web được phép gọi dịch vụ này (cách nhau bằng dấu phẩy)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
